# Local gateway authentication. Generate a long random value.
GATEWAY_API_KEY=change-this-to-a-long-random-secret

# Upstream provider credentials (never commit real keys).
DEEPSEEK_API_KEY=put-your-deepseek-key-here
SILICONFLOW_API_KEY=put-your-siliconflow-key-here

# Upstream API endpoints.
DEEPSEEK_BASE_URL=https://api.deepseek.com
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Model IDs.
# DeepSeek-V4.1-Flash is exposed under the API model ID deepseek-flash.
LLM_MODEL=deepseek-flash
EMB_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Reranker is optional and disabled by default.
RERANKER_ENABLED=false
RERANKER_TOP_N=5

# Upstream timeout in seconds.
HTTP_TIMEOUT=120

# Settings for the starter/solution.py client.
# For a script running on the host use http://127.0.0.1:8000.
# For a script running in the same Compose network use http://model-api:8000.
LLM_BASE_URL=http://127.0.0.1:8000
# Set all three to exactly the same value as GATEWAY_API_KEY.
LLM_API_KEY=change-this-to-a-long-random-secret
EMBEDDER_API_KEY=change-this-to-a-long-random-secret
RERANKER_API_KEY=change-this-to-a-long-random-secret
